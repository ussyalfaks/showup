EXPO_PUBLIC_NETWORK=testnet
EXPO_PUBLIC_CONTRACT_ID=showup.testnet
# Token for USDC cards/events (mainnet default: native USDC on NEAR)
EXPO_PUBLIC_USDC_ID=usdc.fakes.testnet
# Website address once deployed (e.g. https://showup.vercel.app). The phone app then shares
# gift card and event links that open in a browser for people without the app.
# EXPO_PUBLIC_WEB_URL=https://showup.vercel.app
